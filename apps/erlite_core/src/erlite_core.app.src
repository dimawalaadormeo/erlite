{application, erlite_core,
 [{description, "Erlite core OTP application"},
  {vsn, "0.1.0"},
  {registered, [erlite_core_sup, erlite_database_sup, erlite_databases]},
  {mod, {erlite_core_app, []}},
  {applications, [kernel, stdlib, crypto, ra, erlite_catalog, erlite_sqlite,
                  erlite_raft]},
  {env, [{replication_factor, 3}, {seed_nodes, []}]},
  {modules, []}
 ]}.
