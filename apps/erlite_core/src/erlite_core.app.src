{application, erlite_core,
 [{description, "Erlite core OTP application"},
  {vsn, "0.1.0"},
  {registered, [erlite_core_sup, erlite_database_sup, erlite_databases,
                erlite_database_router, erlite_database_lifecycle,
                erlite_replica_repair, erlite_rebalancer,
                erlite_fleet_migrations, erlite_api_server]},
  {mod, {erlite_core_app, []}},
  {applications, [kernel, stdlib, crypto, ssl, ra, erlite_catalog, erlite_sqlite,
                  erlite_raft]},
  {env, [{replication_factor, 3}, {seed_nodes, []},
         {repair_grace_period_ms, 30000}, {repair_scan_interval_ms, 5000},
         {rebalance_scan_interval_ms, 10000},
         {rebalance_max_migrations_per_scan, 1}]},
  {modules, []}
 ]}.
