#!/usr/bin/env bash
# Generated by erlite-deploy for cluster "{{.Config.ClusterName}}", node
# "{{.Node.Name}}" ({{.Node.Host}}). Idempotent: safe to re-run.
#
# Run this ON the target host as a user with sudo, e.g.:
#   scp install-{{.Node.Name}}.sh {{.Config.SSHUser}}@{{.Node.Host}}:~/
#   ssh {{.Config.SSHUser}}@{{.Node.Host}} 'sudo bash ~/install-{{.Node.Name}}.sh'
set -euo pipefail

STORAGE_PATH="{{.Config.StoragePath}}"
NODE_NAME="{{.Node.Name}}@{{.Node.Host}}"
CLUSTER_NAME="{{.Config.ClusterName}}"
REPLICATION_FACTOR={{.Config.ReplicationFactor}}
API_PORT={{.Config.APIPort}}

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root (sudo)" >&2
  exit 1
fi

if ! id erlite >/dev/null 2>&1; then
  useradd --system --home "$STORAGE_PATH" --shell /usr/sbin/nologin erlite
fi

mkdir -p "$STORAGE_PATH"/node "$STORAGE_PATH"/catalog "$STORAGE_PATH"/databases \
         "$STORAGE_PATH"/raft "$STORAGE_PATH"/snapshots "$STORAGE_PATH"/backups
chown -R erlite:erlite "$STORAGE_PATH"

# --- Install the Erlite release ---
# erliteReleaseRef: {{.Config.ErliteReleaseRef}}
# otpVersion:       {{.Config.OTPVersion}}
{{- if .Config.SQLiteBuildID}}
# sqliteBuildId:    {{.Config.SQLiteBuildID}}
{{- end}}
#
# erlite-deploy intentionally does not guess how you distribute releases
# (tarball URL, internal package registry, building from source). Fill this
# step in for your environment, then re-run this script -- see
# DEPLOY_GUIDE.md for details. The rest of this script is safe to leave as
# generated.
if [ ! -x /opt/erlite/bin/erlite ]; then
  echo "TODO: install Erlite release {{.Config.ErliteReleaseRef}} (OTP {{.Config.OTPVersion}}) to /opt/erlite" >&2
  exit 1
fi

mkdir -p /etc/erlite
cat > /etc/erlite/erlite.env <<EOF
NODE_NAME=$NODE_NAME
CLUSTER_NAME=$CLUSTER_NAME
STORAGE_PATH=$STORAGE_PATH
REPLICATION_FACTOR=$REPLICATION_FACTOR
SEED_NODES={{.SeedNodesEnv}}
API_PORT=$API_PORT
EOF
chmod 0640 /etc/erlite/erlite.env
chown root:erlite /etc/erlite/erlite.env

install -m 0644 "$(dirname "$0")/erlite.service" /etc/systemd/system/erlite.service
systemctl daemon-reload
systemctl enable erlite

{{- if .Firewall}}

if command -v ufw >/dev/null 2>&1; then
  ufw allow "$API_PORT"/tcp
  ufw allow {{.DistPortRangeUfw}}/tcp
elif command -v firewall-cmd >/dev/null 2>&1; then
  firewall-cmd --permanent --add-port="$API_PORT"/tcp
  firewall-cmd --permanent --add-port={{.DistPortRangeUfw}}/tcp
  firewall-cmd --reload
fi
{{- end}}

echo "install.sh complete for {{.Node.Name}}. Start with: systemctl start erlite"
