#!/usr/bin/env bash
# Generated by erlite-deploy. Sequences `erlite init-cluster` on the seed
# node, `erlite join` on the rest, then polls /v1/ready on every node.
#
# Run this from a machine with SSH access to every node, after install.sh
# has already been run (and the erlite service started) on each of them.
set -euo pipefail

SSH_USER="{{.Config.SSHUser}}"
API_PORT={{.Config.APIPort}}
SEED_HOST="{{.SeedNode.Host}}"

ssh_run() {
  ssh -o StrictHostKeyChecking=accept-new "$SSH_USER@$1" "$2"
}

echo "==> Starting erlite on all nodes"
{{range .Config.Nodes}}
ssh_run "{{.Host}}" "systemctl start erlite"
{{- end}}

echo "==> Initializing cluster on seed node {{.SeedNode.Name}} ({{.SeedNode.Host}})"
ssh_run "$SEED_HOST" "erlite init-cluster"

{{range .OtherNodes}}
echo "==> Joining {{.Name}} ({{.Host}}) to the cluster"
ssh_run "{{.Host}}" "erlite join {{$.SeedNode.Name}}@$SEED_HOST"
{{- end}}

echo "==> Waiting for every node to report ready"
{{range .Config.Nodes}}
node_ready=0
for i in $(seq 1 30); do
  if ssh_run "{{.Host}}" "curl -sk https://localhost:$API_PORT/v1/ready" | grep -q '"status":"ready"'; then
    echo "{{.Name}} ready"
    node_ready=1
    break
  fi
  sleep 2
done
if [ "$node_ready" -ne 1 ]; then
  echo "{{.Name}} did not become ready in time -- check DEPLOY_GUIDE.md troubleshooting" >&2
  exit 1
fi
{{- end}}

echo "==> Cluster status"
ssh_run "$SEED_HOST" "erlite cluster status"
