#!/usr/bin/env bash
# Generated by erlite-deploy. Copies each node's install-<name>.sh to its
# host and runs it, then hands off to bootstrap-cluster.sh. Run this from a
# machine with SSH access to every node.
set -euo pipefail

SSH_USER="{{.Config.SSHUser}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

{{range .Config.Nodes}}
echo "==> Provisioning {{.Name}} ({{.Host}})"
scp -o StrictHostKeyChecking=accept-new \
  "$SCRIPT_DIR/install-{{.Name}}.sh" "$SCRIPT_DIR/erlite.service" \
  "$SSH_USER@{{.Host}}:~/"
ssh -o StrictHostKeyChecking=accept-new "$SSH_USER@{{.Host}}" \
  "sudo bash ~/install-{{.Name}}.sh"
{{- end}}

echo "==> All nodes provisioned. Running bootstrap-cluster.sh"
"$SCRIPT_DIR/bootstrap-cluster.sh"
