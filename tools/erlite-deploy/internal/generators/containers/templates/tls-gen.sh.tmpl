#!/usr/bin/env bash
# Generated by erlite-deploy. Generates a self-signed CA and one certificate
# per node for cluster "{{.ClusterName}}". Only used when tlsMode is
# "generate-self-signed". Mount the output into each container (see
# DEPLOY_GUIDE.md) and replace with a real CA before production use.
set -euo pipefail
OUT_DIR="${1:-./tls}"
mkdir -p "$OUT_DIR"

openssl req -x509 -newkey rsa:4096 -days 3650 -nodes \
  -keyout "$OUT_DIR/ca.key" -out "$OUT_DIR/ca.crt" \
  -subj "/CN={{.ClusterName}}-ca"

{{range .Nodes}}
openssl req -newkey rsa:4096 -nodes \
  -keyout "$OUT_DIR/{{.Name}}.key" -out "$OUT_DIR/{{.Name}}.csr" \
  -subj "/CN={{.Name}}" \
  -addext "subjectAltName=DNS:{{.Name}},DNS:{{.Host}}"
openssl x509 -req -in "$OUT_DIR/{{.Name}}.csr" \
  -CA "$OUT_DIR/ca.crt" -CAkey "$OUT_DIR/ca.key" -CAcreateserial \
  -out "$OUT_DIR/{{.Name}}.crt" -days 825 -copy_extensions copy
rm -f "$OUT_DIR/{{.Name}}.csr"
{{- end}}

echo "TLS material written to $OUT_DIR"
