# Generated by erlite-deploy for cluster "{{.Config.ClusterName}}".
# Usable with `docker compose up -d` or `podman-compose up -d` / `podman compose up -d`.
services:
{{- range .Nodes}}
  {{.Name}}:
{{- if eq $.Config.ImageSource "build"}}
    build: .
{{- else}}
    image: {{$.Config.ImageRef}}
{{- end}}
    container_name: erlite-{{.Name}}
    hostname: {{.Name}}
    environment:
      ERLITE_NODE_NAME: "{{.Name}}@{{.Name}}"
      ERLITE_CLUSTER_NAME: "{{$.Config.ClusterName}}"
      ERLITE_STORAGE_PATH: "{{$.Config.StoragePath}}"
      ERLITE_REPLICATION_FACTOR: "{{$.Config.ReplicationFactor}}"
      ERLITE_SEED_NODES: "{{$.SeedNodesEnv}}"
      ERLITE_API_PORT: "{{$.Config.APIPort}}"
    volumes:
      - {{.Name}}-data:{{$.Config.StoragePath}}
    ports:
      # host:container -- each node gets its own host-side port since they
      # share this host's network namespace; every container listens on
      # {{$.Config.APIPort}} internally regardless of its host mapping.
      - "{{.HostPort}}:{{$.Config.APIPort}}"
    networks:
      - erlite-cluster
    restart: unless-stopped
{{- end}}

networks:
  erlite-cluster:
    driver: bridge

volumes:
{{- range .Nodes}}
  {{.Name}}-data: {}
{{- end}}
