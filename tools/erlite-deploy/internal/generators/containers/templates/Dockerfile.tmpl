# Generated by erlite-deploy. Builds an Erlite release image pinned to
# otpVersion={{.OTPVersion}}, erliteReleaseRef={{.ErliteReleaseRef}}.
#
# This assumes a standard rebar3 release layout (rebar.config at the repo
# root, a release named "erlite"). Adjust ERLITE_SOURCE below if your build
# process differs -- see DEPLOY_GUIDE.md.
FROM erlang:{{.OTPVersion}}-alpine AS build
WORKDIR /build
ARG ERLITE_SOURCE={{.ErliteReleaseRef}}
COPY . .
RUN rebar3 as prod release

FROM alpine:latest
RUN apk add --no-cache libstdc++ ncurses-libs openssl
COPY --from=build /build/_build/prod/rel/erlite /opt/erlite
ENTRYPOINT ["/opt/erlite/bin/erlite"]
CMD ["foreground"]
