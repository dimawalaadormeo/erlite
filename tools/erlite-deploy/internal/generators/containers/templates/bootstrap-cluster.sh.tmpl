#!/usr/bin/env bash
# Generated by erlite-deploy. Sequences `erlite init-cluster` on the seed
# container, `erlite join` on the rest, then polls /v1/ready on every
# container. Run after `docker compose up -d` (or the podman equivalent).
set -euo pipefail

ENGINE="${ERLITE_CONTAINER_ENGINE:-docker}"  # or "podman"
API_PORT={{.Config.APIPort}}

echo "==> Initializing cluster on seed node {{.SeedNode.Name}}"
"$ENGINE" exec "erlite-{{.SeedNode.Name}}" erlite init-cluster

{{range .OtherNodes}}
echo "==> Joining {{.Name}}"
"$ENGINE" exec "erlite-{{.Name}}" erlite join {{$.SeedNode.Name}}@{{$.SeedNode.Name}}
{{- end}}

echo "==> Waiting for every node to report ready"
{{range .Config.Nodes}}
node_ready=0
for i in $(seq 1 30); do
  if "$ENGINE" exec "erlite-{{.Name}}" sh -c "curl -sk https://localhost:$API_PORT/v1/ready" | grep -q '"status":"ready"'; then
    echo "{{.Name}} ready"
    node_ready=1
    break
  fi
  sleep 2
done
if [ "$node_ready" -ne 1 ]; then
  echo "{{.Name}} did not become ready in time -- check DEPLOY_GUIDE.md troubleshooting" >&2
  exit 1
fi
{{- end}}

echo "==> Cluster status"
"$ENGINE" exec "erlite-{{.SeedNode.Name}}" erlite cluster status
